@using EverythingSucks.ViewModels
@model List<OrderViewModel>
@{
    ViewData["Title"] = "Đơn hàng";
    Layout = "_AdminLayout";
}

<!-- Order Details Section Begin -->
<div class="d-flex justify-content-center pb-3">
    <h3 class="text-center">Lịch sử mua hàng</h3>
</div>
<section class="order-details">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="order__details__table">
                    <table>
                        <thead>
                            <tr>
                                <th class="col-2">Mã đơn hàng</th>
                                <th class="col-3">Phương thức thanh toán</th>
                                <th class="col-3">Ngày tạo</th>
                                <th class="col-3">Trạng thái đơn hàng</th>
                                <th class="col-1">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="col-2">
                                        @item.OrderId
                                    </td>
                                    <td class="col-3">
                                        @item.PaymentMethod
                                    </td>
                                    <td class ="col-3">
                                        @item.CreatedAt
                                    </td>
                                    <td class="col-3">
                                        @item.OrderStatus.Name
                                    </td>
                                    <td class="col-1">
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Detail" asp-route-orderId="@item.OrderId">Xem</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Order Details Section End -->
