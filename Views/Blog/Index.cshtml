@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Khám Phá Bộ Sưu Tập Quần Áo Nam";
}

<!-- Meta tags for SEO and Open Graph -->
@section MetaTags {
    <link rel="canonical" href="@Url.Action("Index", "BLog", null , Context.Request.Scheme)" />
    <title>Khám Phá Bộ Sưu Tập Quần Áo Nam</title>
    <meta name="description" content="Chào mừng bạn đến với bộ sưu tập quần áo nam thời trang của chúng tôi, nơi bạn sẽ tìm thấy những trang phục không chỉ phản ánh phong cách hiện đại mà còn mang đến sự thoải mái tối ưu cho từng dịp." />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Khám Phá Bộ Sưu Tập Quần Áo Nam" />
    <meta property="og:description" content="Chào mừng bạn đến với bộ sưu tập quần áo nam thời trang của chúng tôi, nơi bạn sẽ tìm thấy những trang phục không chỉ phản ánh phong cách hiện đại mà còn mang đến sự thoải mái tối ưu cho từng dịp." />
    <meta property="og:image" content="https://esecommerce-dqg7cfhnb4dxgxh0.eastus-01.azurewebsites.net/img/blog/details/blog-details.jpg" />
    <meta property="og:image:width" content="200" />
    <meta property="og:image:height" content="200" />
    <meta property="og:url" content="@Url.Action("Index", "BLog", null , Context.Request.Scheme)" />
    <meta property="og:type" content="article" />
}

<!-- Blog Details Hero Begin -->
<section class="blog-hero spad">
    <div class="container">
        <div class="row d-flex justify-content-center">
            <div class="col-lg-9 text-center">
                <div class="blog__hero__text">
                    <h2>Khám Phá Bộ Sưu Tập Quần Áo Nam</h2>
                    <ul>
                        <li>Viết bởi EverythingSucks</li>
                        <li>Tháng 8 12, 2024</li>
                        <li>0 Comments</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Details Hero End -->
<!-- Blog Details Section Begin -->
<section class="blog-details spad">
    <div class="container">
        <div class="row d-flex justify-content-center">
            <div class="col-lg-12">
                <div class="blog__details__pic">
                    <img src="~/img/blog/details/blog-details.jpg" alt="blog-image">
                </div>
            </div>
            <div class="col-lg-8">
                <div class="blog__details__content">
                    <div class="blog__details__text">
                        <p>
                            Chào mừng bạn đến với bộ sưu tập quần áo nam thời trang của chúng tôi, nơi bạn sẽ tìm thấy những trang phục không chỉ phản ánh phong cách hiện đại mà còn mang đến sự thoải mái tối ưu cho từng dịp. Chúng tôi tự hào mang đến một loạt các sản phẩm đa dạng từ những bộ đồ công sở lịch lãm đến trang phục thể thao năng động, phù hợp với nhu cầu và sở thích của mọi quý ông.
                        </p>
                        <strong>
                            Áo Sơ Mi – Sự Kết Hợp Hoàn Hảo Giữa Thanh Lịch Và Thoải Mái
                        </strong>
                        <hr />
                        <p>
                            Áo sơ mi là một phần không thể thiếu trong tủ đồ của mỗi người đàn ông. Bộ sưu tập áo sơ mi của chúng tôi được thiết kế với các kiểu dáng và màu sắc khác nhau, từ những chiếc áo sơ mi trắng cổ điển cho các cuộc họp quan trọng, đến những mẫu áo sơ mi họa tiết trẻ trung, năng động cho những buổi dạo phố hay gặp gỡ bạn bè. Chất liệu vải cao cấp và đường may tỉ mỉ đảm bảo rằng bạn sẽ luôn cảm thấy tự tin và thoải mái suốt cả ngày dài.
                        </p>
                    </div>
                    <div class="blog__details__quote">
                        <i class="fa fa-quote-left"></i>
                        <p>
                            “Thời trang là cách bạn thể hiện bản thân mà không cần phải nói một lời nào.”
                        </p>
                        <h6>_ Miuccia Prada _</h6>
                    </div>
                    <div class="blog__details__text">
                        <strong>
                            Áo Khoác – Phong Cách Và Bảo Vệ Trong Mọi Thời Tiết
                        </strong>
                        <hr />
                        <p>
                            Khi thời tiết thay đổi, một chiếc áo khoác chất lượng là sự lựa chọn lý tưởng để vừa giữ ấm vừa duy trì phong cách. Bộ sưu tập áo khoác của chúng tôi bao gồm các mẫu áo khoác da sang trọng, áo khoác bomber cá tính và áo khoác lông vũ ấm áp. Mỗi chiếc áo khoác đều được thiết kế với sự chú trọng đến cả yếu tố thẩm mỹ và tính năng, giúp bạn tự tin đối mặt với mọi điều kiện thời tiết
                        </p>
                        <strong>
                            Quần Jeans Và Quần Tây – Sự Kết Hợp Đầy Đủ Từ Đời Thường Đến Lịch Lãm
                        </strong>
                        <hr />
                        <p>
                            Chúng tôi cung cấp nhiều kiểu dáng quần khác nhau để đáp ứng nhu cầu đa dạng của bạn. Từ quần jeans cổ điển, dễ phối đồ cho những ngày cuối tuần, đến quần tây lịch lãm cho các sự kiện trang trọng hay làm việc tại văn phòng, bộ sưu tập của chúng tôi có đủ mọi lựa chọn để bạn dễ dàng tìm được sản phẩm phù hợp nhất. Chất liệu vải bền bỉ và thiết kế tinh tế giúp bạn cảm thấy thoải mái mà vẫn giữ được vẻ ngoài chỉn chu.
                        </p>
                    </div>
                    <div class="blog__details__text">
                        <strong>
                            Phụ Kiện – Điểm Nhấn Hoàn Hảo Cho Phong Cách Của Bạn
                        </strong>
                        <hr />
                        <p>
                            Để hoàn thiện trang phục của mình, đừng quên tham khảo các phụ kiện đi kèm như thắt lưng, cà vạt và đồng hồ. Những chi tiết nhỏ này không chỉ làm tăng vẻ đẹp của bộ trang phục mà còn thể hiện sự chú trọng đến phong cách cá nhân. Chúng tôi cung cấp các phụ kiện được làm từ chất liệu cao cấp và thiết kế tinh tế, giúp bạn tỏa sáng trong mọi tình huống.
                        </p>
                        <strong>
                            Chất Lượng Và Dịch Vụ – Cam Kết Của Chúng Tôi
                        </strong>
                        <hr />
                        <p>
                            Chúng tôi cam kết cung cấp sản phẩm quần áo nam chất lượng nhất với giá trị tốt nhất. Mỗi sản phẩm đều được kiểm tra kỹ lưỡng để đảm bảo đáp ứng các tiêu chuẩn cao nhất về chất lượng và sự thoải mái. Hơn nữa, đội ngũ nhân viên tận tâm của chúng tôi luôn sẵn sàng hỗ trợ bạn trong việc lựa chọn và chăm sóc khách hàng để đảm bảo bạn có trải nghiệm mua sắm tuyệt vời.
                        </p>
                    </div>
                    <div class="blog__details__option">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <div class="blog__details__author">
                                    <div class="blog__details__author__pic">
                                        <img src="~/author.jpg" alt="Author">
                                    </div>
                                    <div class="blog__details__author__text">
                                        <h5>EverythingSucks</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <div class="blog__details__tags">
                                    <a href="#">#Thời trang nam</a>
                                    <a href="#">#Xu hướng</a>
                                    <a href="#">#2030</a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="sharethis-inline-share-buttons"></div>
                    </div>
                    <div class="blog__details__btns">
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <a href="" class="blog__details__btns__item">
                                    <p><span class="arrow_left"></span> Previous Pod</p>
                                    <h3>It S Classified How To Utilize Free Classified Ad Sites</h3>
                                </a>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <a href="" class="blog__details__btns__item blog__details__btns__item--next">
                                    <p>Next Pod <span class="arrow_right"></span></p>
                                    <h3>Tips For Choosing The Perfect Gloss For Your Lips</h3>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="blog__details__comment">
                        <h4>Leave A Comment</h4>
                        <form action="#">
                            <div class="row">
                                <div class="col-lg-4 col-md-4">
                                    <input type="text" placeholder="Name">
                                </div>
                                <div class="col-lg-4 col-md-4">
                                    <input type="text" placeholder="Email">
                                </div>
                                <div class="col-lg-4 col-md-4">
                                    <input type="text" placeholder="Phone">
                                </div>
                                <div class="col-lg-12 text-center">
                                    <textarea placeholder="Comment"></textarea>
                                    <button type="submit" class="site-btn">Post Comment</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Blog Details Section End -->
