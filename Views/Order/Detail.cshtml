@using EverythingSucks.ViewModels
@model List<OrderItemViewModel>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "_LayoutCustomer";
    var cultureInfo = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<!-- Order Details Section Begin -->
<div class="d-flex justify-content-center pb-3">
    <h3 class="text-center">Chi tiết đơn hàng</h3>
</div>
<section class="order-details">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="order__details__table">
                    <table class="table table-fixed table-bordered">
                        <thead>
                            <tr>
                                <th class="col-4">Sản phẩm</th>
                                <th class="col-2 text-center">Kích cỡ</th>
                                <th class="col-2 text-center">Số lượng</th>
                                <th class="col-2 text-center">Giá tiền</th>
                                <th class="col-2 text-center">Tổng cộng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var productPrice = item.ProductColor.Product.Price;
                                var quantity = item.Quantity;
                                var totalPrice = productPrice * quantity;
                                <tr>
                                    <td class="col-4">
                                        <div class="d-flex align-items-center align-middle">
                                            <img style="width:100px; height:100px" src="@item.ProductColor.ProductImages.FirstOrDefault(img=> img.ProductColorId == item.ProductColorId && img.IsPrimary == true)?.Url" alt="productImage" />
                                            <p class="pl-3">
                                                @item.ProductColor.Product.Name
                                            </p>
                                        </div>
                                    </td>
                                    <td class="col-2 text-center align-middle">
                                        @item.Size.Name
                                    </td>
                                    <td class="col-2 text-center align-middle">
                                        @quantity
                                    </td>
                                    <td class="col-2 text-center align-middle">
                                        @productPrice.ToString("C0", cultureInfo)
                                    </td>
                                    <td class="col-2 text-center align-middle">
                                        <strong>
                                            @totalPrice.ToString("C0", cultureInfo)
                                        </strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Order Details Section End -->

<style>
    .table-fixed {
        table-layout: fixed;
        width: 100%;
    }

        .table-fixed th, .table-fixed td {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

            .table-fixed th.col-4 {
                width: 40%; /* Hoặc bất kỳ kích thước cố định nào bạn muốn */
            }

            .table-fixed th.col-2 {
                width: 20%; /* Hoặc bất kỳ kích thước cố định nào bạn muốn */
            }

        .table-fixed img {
            max-width: 80px;
            max-height: 80px;
            object-fit: cover;
        }
</style>